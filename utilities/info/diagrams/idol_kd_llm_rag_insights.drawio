<mxfile host="app.diagrams.net">
  <diagram name="LLM + KD Insights (Polished)" id="kd-llm-2">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ STEP 1: Standalone LLM ============ -->
        <mxCell id="llm" value="Standalone LLM&#10;&#10;• Generalist, trained on broad data&#10;• No access to private/internal docs&#10;• Can hallucinate or be outdated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="320" height="160" as="geometry" />
