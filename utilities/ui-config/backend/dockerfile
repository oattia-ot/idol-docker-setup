# =============================================================================
# backend/Dockerfile
# =============================================================================
# Apache NiFi GitHub Registry & Parameter Context Manager
# Flask-based web UI + REST API for managing NiFi flows, registries,
# parameter contexts, and Docker-hosted NiFi instances.
#
# Base image: Python 3.9 slim (minimal footprint + security)
# =============================================================================

FROM python:3.9-slim

# =============================================================================
# 1. SYSTEM DEPENDENCIES
# =============================================================================
# Installs:
#   • ca-certificates, curl, gnupg   → required for Docker repository
#   • docker-ce-cli                  → allows the Flask app to interact with
#                                     the host Docker daemon (docker-py + CLI)
#
# Using the official Docker installation method (2025+ recommended)
# Avoids deprecated lsb-release and uses /etc/os-release for reliability.
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/* \
    # Add Docker's official GPG key to new keyring location
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    # Add Docker repository using current Debian codename
    && echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
      https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
    tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# 2. APPLICATION SETUP
# =============================================================================
WORKDIR /app

# Copy and install Python dependencies first (better layer caching)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Explicitly pin these two packages (safety net in case they're missing from requirements.txt)
RUN pip install --no-cache-dir flask-limiter==3.3.0 flask-caching==2.1.0

# Copy application code
COPY backend/app.py .

# Copy frontend assets (templates + static files)
COPY frontend/templates ./templates
COPY frontend/static ./static

# =============================================================================
# 3. PERSISTENT VOLUME FOR SCRIPT EXECUTION
# =============================================================================
# The app writes and executes setup scripts here.
# We pre-create the directory and give it broad permissions so the
# non-root Flask process can write `pre-setup.out` and scripts.
# =============================================================================
RUN mkdir -p /setup-scripts && \
    touch /setup-scripts/pre-setup.out && \
    chmod 777 /setup-scripts

# =============================================================================
# 4. RUNTIME CONFIGURATION
# =============================================================================
EXPOSE 5000

ENV FLASK_APP=app.py \
    FLASK_ENV=production \
    PYTHONUNBUFFERED=1

# =============================================================================
# 5. START COMMAND
# =============================================================================
CMD ["python", "app.py"]