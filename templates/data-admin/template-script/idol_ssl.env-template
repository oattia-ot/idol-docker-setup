# ============================================
# IDOL SSL Configuration - Shared across all components
# Loaded via env_file in docker-compose.ssl.yml
#
# Per-service settings (IDOL_SSL_COMPONENT_CERT_PATH,IDOL_SSL_COMPONENT_KEY_PATH) are set in docker-compose.ssl.yml
# because they differ per container.
# ============================================

# REQUIRED: Activate SSL for all IDOL components
IDOL_SSL=1

# ============================================
# Certificate Authority Settings
# ============================================

# Container mount point — matches target in x-ssl-volume (docker-compose.ssl.yml)
IDOL_SSL_CA_MOUNTDIR=/ssl

# Paths relative to IDOL_SSL_CA_MOUNTDIR (/ssl)
# These point to the Intermediate CA (used to sign service certs)
IDOL_SSL_CACERT=certs/intermediate.cert.pem
IDOL_SSL_CAKEY=private/intermediate.key.pem
IDOL_SSL_CAPASS=${IDOL_CERT_KEYSTORE_PASS}

# ============================================
# Certificate Directory Structure
# (relative to IDOL_SSL_CA_MOUNTDIR)
# ============================================

USER_SSL_CERTS_DIR=certs
USER_SSL_NEWCERTS_DIR=issued
USER_SSL_DATABASE_FILE=issued/index.txt
USER_SSL_SERIAL_FILE=issued/serial
USER_SSL_CRLNUMBER_FILE=issued/crlnumber
USER_SSL_RANDFILE=private/.rand

# ============================================
# Trust Store Files
# (relative to IDOL_SSL_CA_MOUNTDIR)
# ============================================

# ROOT_CERTIFICATE must point to the Root CA (not intermediate)
# so that clients can verify the full chain
ROOT_CERTIFICATE=certs/ca.cert.pem
CA_CHAIN_FILE=certs/ca-chain.cert.pem
USER_ISSUING_CA_PKCS12=certs/intermediate.pkcs12

# ============================================
# SSL Protocol Settings
# ============================================

SSL_METHOD=TLSV1_2_OR_LATER
SSL_CIPHER_LIST=HIGH:!aNULL:!MD5:!3DES:!RC4

# Verify certificates from other IDOL components
SSL_CHECK_CERTIFICATE=True
# Do not enforce CN matching (Docker service names vs cert CN may differ)
SSL_CHECK_COMMON_NAME=False

# ============================================
# Inter-Component SSL
# ============================================

# Enable SSL for all inter-component communication
IDOL_COMPONENT_USE_SSL=true

# Full path to CA chain inside the container
# Used by IDOL components to verify peers
SSL_CA_CERTIFICATES_PATH=/ssl/certs/ca-chain.cert.pem

# ============================================
# NiFi-Specific SSL Settings
# ============================================

# NiFi uses different SSL activation
USE_SSL=true

# NiFi keystore and truststore (if using JKS format)
NIFI_KEYSTORE_PATH=/ssl/nifi/keystore.jks
NIFI_TRUSTSTORE_PATH=/ssl/nifi/truststore.jks