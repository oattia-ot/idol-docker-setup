# This is designed to be used atop of docker-compose.add-mmap.yml
# Therefore the incantation to use this is something like
# docker-compose -f docker-compose.yml -f docker-compose.ssl.yml 
#  -f docker-compose.add-mmap.yml 
#  -f docker-compose.add-mmap.ssl.yml up 

version: "3.8"
name: ${IDOL_DEPLOYMENT_TYPE:-idol-demo}

services:
  idol-mediaserver:
    env_file:
      - idol_ssl.env   
    environment:
      - IDOL_SSL_COMPONENT_CERT_PATH=/ssl/certs/idol-mediaserver-fullchain.cert.pem
      - IDOL_SSL_COMPONENT_KEY_PATH=/ssl/certs/idol-mediaserver.key.pem  
    volumes:
      - ./ssl/intermediate:/ssl:ro
  idol-mmap-app:
    env_file:
      - idol_ssl.env
    environment:
      - IDOL_SSL_COMMON_NAME=mmap.microfocus.com
      - IDOL_SSL_SUBJ_ALT_NAME=*.microfocus.com
    volumes:
      - ./ssl/intermediate:/ssl:ro
# N.B. mmap doesn't yet support an https playlistserver      
  idol-mmap-playlistserver:
    env_file:
      - idol_ssl.env
    environment:
      - IDOL_SSL_COMPONENT_CERT_PATH=/ssl/certs/idol-mmap-playlistserver-fullchain.cert.pem
      - IDOL_SSL_COMPONENT_KEY_PATH=/ssl/certs/idol-mmap-playlistserver.key.pem  
    volumes:
      - ./ssl/intermediate:/ssl:ro      
