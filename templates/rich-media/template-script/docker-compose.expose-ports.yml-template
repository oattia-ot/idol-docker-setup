# expose internal service ports that don't necessarily
# need to be exposed to the outside world

version: "3.8"
name: ${IDOL_DEPLOYMENT_TYPE:-idol-demo}

services:
  idol-content:
    ports:
      - BI_CONTENT_ACI_PLACEHOLDER-BI_CONTENT_SRV_PLACEHOLDER:BI_CONTENT_ACI_PLACEHOLDER-BI_CONTENT_SRV_PLACEHOLDER
  idol-agentstore:
    ports:
      - BI_AGENTSTORE_ACI_PLACEHOLDER-BI_AGENTSTORE_SRV_PLACEHOLDER:BI_AGENTSTORE_ACI_PLACEHOLDER-BI_AGENTSTORE_SRV_PLACEHOLDER
  idol-category:
    ports:
      - BI_CATEGORY_ACI_PLACEHOLDER-BI_CATEGORY_SRV_PLACEHOLDER:BI_CATEGORY_ACI_PLACEHOLDER-BI_CATEGORY_SRV_PLACEHOLDER      
  idol-categorisation-agentstore:
    ports:
      - BI_CATEGORISATION_AGENTSTORE_ACI_PLACEHOLDER-BI_CATEGORISATION_AGENTSTORE_SRV_PLACEHOLDER:BI_CATEGORISATION_AGENTSTORE_ACI_PLACEHOLDER-BI_CATEGORISATION_AGENTSTORE_SRV_PLACEHOLDER
  idol-community:
    ports:
      - BI_COMMUNITY_ACI_PLACEHOLDER-BI_COMMUNITY_SRV_PLACEHOLDER:BI_COMMUNITY_ACI_PLACEHOLDER-BI_COMMUNITY_SRV_PLACEHOLDER
  idol-view:
    ports:
      - BI_VIEW_ACI_PLACEHOLDER-BI_VIEW_SRV_PLACEHOLDER:BI_VIEW_ACI_PLACEHOLDER-BI_VIEW_SRV_PLACEHOLDER
