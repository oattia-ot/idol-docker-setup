# Basic IDOL container setup
# Uses nifi to ingest and index data into content
# Uses find to make search results available
# Default admin user is created for find in the community service
#  - see community/run_community.sh for details

version: "3.8"
name: ${IDOL_DEPLOYMENT_TYPE:-idol-demo}

x-common-labels: &common-labels
  docker-compose/instance: ${INSTANCE:-basic-idol}

x-common-server: &common-server
# Change the IP to the address of an external IDOL LicenseServer instance
  extra_hosts:
  - idol-licenseserver:${LICENSESERVER_IP}
  labels:
    <<: *common-labels

x-args-shared: 
  - &mmap-postgres-password ieBPwmujrKEY9sh6oaybA8wyf

volumes:
  items: &common-volume
    labels:
      <<: *common-labels
  static_video:
    <<: *common-volume
  mediaserver-processed-video:
    <<: *common-volume
  mmap-postgres-events: # Persistent storage for db
    <<: *common-volume
  # Any files dropped into this volume will be ingested and indexed
  idol-ingest-volume:
    labels:
      <<: *common-labels

services:
  idol-content: 
    <<: *common-server
    image: ${IDOL_REGISTRY}/content:${IDOL_SERVER_VERSION}
    volumes:
      - PRESERVE-CONTENT-PATH-PLACEHOLDER/cfg:/content/cfg:rw     # this mounts an external cfg folder
      - PRESERVE-CONTENT-PATH-PLACEHOLDER/index:/content/index    # this mounts an external index 
      - PRESERVE-CONTENT-PATH-PLACEHOLDER/index/main/qssp.db:/content/index/main/qssp.db      # this mounts an external qssp.db database for Hebrew phrase support (if needed) 
      - PRESERVE-CONTENT-PATH-PLACEHOLDER/langfiles/hebrew.dat:/content/langfiles/hebrew.dat  # this mounts an external hebrew language pack (if needed) 
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER       
  idol-agentstore:
    <<: *common-server
    image: ${IDOL_REGISTRY}/agentstore:${IDOL_SERVER_VERSION}  
    volumes:
      - PRESERVE-AGENTSTORE-PATH-PLACEHOLDER/cfg:/agentstore/cfg:rw     # this mounts an external cfg folder 
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER       
  idol-category:
    <<: *common-server
    image: ${IDOL_REGISTRY}/category:${IDOL_SERVER_VERSION}  
    volumes:
      - PRESERVE-CATEGORY-PATH-PLACEHOLDER/cfg:/category/cfg:rw           # this mounts an external cfg folder  
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER           
  idol-categorisation-agentstore:
    <<: *common-server
    image: ${IDOL_REGISTRY}/categorisation-agentstore:${IDOL_SERVER_VERSION}
    volumes:
      - PRESERVE-CATEGORISATION-AGENTSTORE-PATH-PLACEHOLDER/cfg:/categorisation-agentstore/cfg:rw     # this mounts an external cfg folder 
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER       
  idol-community:
    <<: *common-server
    image: ${IDOL_REGISTRY}/community:${IDOL_SERVER_VERSION}
    volumes:
      - PRESERVE-COMMUNITY-PATH-PLACEHOLDER/cfg:/community/cfg:rw     # this mounts an external cfg folder 
    depends_on:
      - idol-content
      - idol-agentstore    
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER       
  idol-view:
    <<: *common-server
    image: ${IDOL_REGISTRY}/view:${IDOL_SERVER_VERSION}
    volumes:
      - VIEW-PATH-PLACEHOLDER/cfg/view.cfg:/view/cfg/view.cfg  
      - VIEW-PATH-PLACEHOLDER/filters/formats_e.ini:/view/filters/formats_e.ini  
      - idol-ingest-volume:/idol-ingest     
    depends_on:
      - idol-agentstore
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER       
  idol-nifi:
    <<: *common-server
    image: ${IDOL_REGISTRY}/nifi-ver2-full:${IDOL_SERVER_VERSION} # choose nifi-ver2-minimal or nifi-ver2-full
    shm_size: 256m
    environment:
      NIFI_WEB_PROXY_CONTEXT_PATH: /idol-nifi
      NIFI_SENSITIVE_PROPS_KEY: my_nifi_sensitive_props_key
      #HTTPS: configuration Section
      NIFI_WEB_HTTPS_PORT: NIFI_UI_PLACEHOLDER
      NIFI_WEB_HTTPS_HOST: 0.0.0.0
      NIFI_WEB_PROXY_HOST: localhost:NIFI_UI_PLACEHOLDER,127.0.0.1:NIFI_UI_PLACEHOLDER,idol-docker-host:NIFI_UI_PLACEHOLDER,NIFI-FQDN-PLACEHOLDER:NIFI_UI_PLACEHOLDER,${IDOL_NET_HOST_IP}:NIFI_UI_PLACEHOLDER,${EXTRA_IP_SANS_ENV}:NIFI_UI_PLACEHOLDER
      SINGLE_USER_CREDENTIALS_USERNAME: admin
      SINGLE_USER_CREDENTIALS_PASSWORD: OpenText2026!
      LANG: C.UTF-8
      LC_ALL: C.UTF-8
    volumes:
      - idol-ingest-volume:/idol-ingest
      - idol-staging-volume:/idol-staging
      - NIFI-SCRIPTS-PATH-PLACEHOLDER:/idol-scripts
      - NIFI-CONNECTOR-NAR-PATH-PLACEHOLDER:/opt/nifi/nifi-current/tempfolder-nifi-connectors
      - SHARED-FOLDER-PATH-PLACEHOLDER/richmedia-packages:/opt/nifi/nifi-current/tempfolder-richmedia-packages 
      ## These need to be copied from the container initially
      - NIFI-DATA-PATH-PLACEHOLDER/conf:/opt/nifi/nifi-current/conf
      ## The following entries are all initially empty directories that nifi will populate
      # ./nifi/data/data:/opt/nifi/nifi-current/data
      # ./nifi/data/run:/opt/nifi/nifi-current/run
      # ./nifi/data/state:/opt/nifi/nifi-current/state
      # ./nifi/data/keytool:/opt/nifi/nifi-current/keytool
      # ./nifi/data/content_repository:/opt/nifi/nifi-current/content_repository
      # ./nifi/data/database_repository:/opt/nifi/nifi-current/database_repository
      # ./nifi/data/flowfile_repository:/opt/nifi/nifi-current/flowfile_repository
      # ./nifi/data/provenance_repository:/opt/nifi/nifi-current/provenance_repository
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER       
  idol-find:
    image: ${IDOL_REGISTRY}/find:${IDOL_SERVER_VERSION}
    labels:
      <<: *common-labels
    environment:
      #- IDOL_UI_CFG=config_basic.json # this controls the configuration of Find
      - IDOL_UI_CFG=config_ssl.json
      - IDOL_UI_STARTUP_SCRIPT=ui_start_ssl.sh
      # PKCS12 cert for Find's Tomcat SSL listener
      - IDOL_UI_SSL_PKCS_FILE=/ssl/certs/idol-find.pkcs12
      - IDOL_UI_SSL_PKCS_PASS=${IDOL_CERT_KEYSTORE_PASS}
      # Intermediate CA PKCS12 (imported into Find's truststore)
      - IDOL_UI_SSL_CA_PKCS12=/ssl/certs/intermediate.pkcs12
      - IDOL_UI_SSL_CA_PASS=${IDOL_CERT_KEYSTORE_PASS}
      # Root CA cert (also imported into truststore)
      - IDOL_UI_ROOT_CERTIFICATE=/ssl/certs/ca.cert.pem      
    depends_on:
      - idol-community
      - idol-view
    # Volume mount to persist find home data
    volumes:
      - FIND-PATH-PLACEHOLDER/basic-idol/home:/opt/find/home
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER       
  httpd-reverse-proxy:
    image: httpd:2.4
    labels:
      <<: *common-labels
    volumes:
      - ./httpd-reverse-proxy/httpd.conf:/usr/local/apache2/conf/httpd.conf:ro
    depends_on:
      - idol-find
      - idol-nifi
    ports:
      - BI_HTTPD_REVERSE_PLACEHOLDER:8080
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER 
      
networks:
  DEPLOYMENT-TYPE-PLACEHOLDER:
    external: true  
