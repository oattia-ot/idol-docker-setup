# The incantation to use this is
# docker-compose -f docker-compose.yml -f docker-compose.add-mmap.yml up

version: "3.8"
name: ${IDOL_DEPLOYMENT_TYPE:-idol-demo}

x-common-labels: &common-labels
  docker-compose/instance: ${INSTANCE:-rich-media}

x-common-server: &common-server
# Change the IP to the address of an external IDOL LicenseServer instance
  extra_hosts:
  - idol-licenseserver:${LICENSESERVER_IP}
  labels:
    <<: *common-labels

x-args-shared: 
  - &mmap-postgres-password ieBPwmujrKEY9sh6oaybA8wyf

volumes:
  items: &common-volume
    labels:
      <<: *common-labels
  static_video:
    <<: *common-volume
  mediaserver-processed-video:
    <<: *common-volume
  mmap-postgres-events: # Persistent storage for db
    <<: *common-volume

services:
  # modified services
  idol-nifi:
    depends_on: [idol-mmap-app]
    volumes:
      - ./nifi/flow/with.mmap.xml:/opt/nifi/flow/this_flow.xml:ro # this controls which NiFi flow is used
      - mediaserver-processed-video:/processed-video

  # additional services
  idol-mediaserver:
    <<: *common-server
    image: ${IDOL_REGISTRY}/mediaserver-english:${IDOL_RICH_MEDIA_VERSION}
    ports:
      - 14000-14001:14000-14001
    volumes:
      - mediaserver-processed-video:/processed-video
      - /home/kduser/idol-sandbox/persistent-data/mediaserver/cfg:/mediaserver/cfg:rw         # expose the mediaserver config for editing
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER   
  idol-mmap-postgres:
    image: postgres:11-alpine
    labels:
      <<: *common-labels
    environment: 
      POSTGRES_DB: mmap-events
      POSTGRES_USER: mmap
      POSTGRES_PASSWORD: *mmap-postgres-password
    volumes:
      - mmap-postgres-events:/var/lib/postgresql/data
      - ../common-files/mmap-postgres/schema:/docker-entrypoint-initdb.d
  idol-mmap-playlistserver:
    <<: *common-server
    image: ${IDOL_REGISTRY}/mediaserver-playlistserver:${IDOL_RICH_MEDIA_VERSION}
    ports:
      - 24000-24001:24000-24001
    volumes:
      - static_video:/mmap/data/static-video/final
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER 
  idol-mmap-app:
    <<: *common-server
    depends_on: [idol-mmap-postgres, idol-mmap-playlistserver]
    image: ${IDOL_REGISTRY}/mmap_app:24.3
    environment:
      MMAP_POSTGRES_PASSWORD: *mmap-postgres-password
      IDOL_SSL: "true"                                            
      IDOL_UI_SSL_PKCS_FILE: /ssl/certs/idol-mmap-app.pkcs12
      IDOL_UI_SSL_PKCS_PASS: ${IDOL_CERT_KEYSTORE_PASS}
      IDOL_UI_SSL_CA_PKCS12: /ssl/certs/intermediate.pkcs12       
      IDOL_UI_SSL_CA_PASS: ${IDOL_CERT_KEYSTORE_PASS}           
      IDOL_UI_ROOT_CERTIFICATE: /ssl/certs/ca.cert.pem 
    ports:
      - 8002:8080
      - 8445:8445
    volumes:
      # expose the MMAP config for editing
      #- "${MMAP_CONFIG_DIR?MMAP_CONFIG_DIR}/application:${MMAP_DIR?MMAP_DIR}/config"
      # access recorder video data, eg. rolling buffer
      #- "${MMAP_DATA_DIR?MMAP_DATA_DIR}/streaming-video:${MMAP_DIR?MMAP_DIR}/input-data/streaming-video"
      # provide somewhere to put video files so MMAP can read them when creating a video
      #- "${MMAP_DATA_DIR?MMAP_DATA_DIR}/static-video:${MMAP_DIR?MMAP_DIR}/input-data/static-video"
      - mediaserver-processed-video:/mmap/input-data/static-video
      # persist repository data
      - "items:${MMAP_DIR?MMAP_DIR}/data/items"
      - static_video:/mmap/data/static-video/final
      # server cert
      - /home/kduser/idol-sandbox/idol-containers-toolkit/basic-idol/ssl/intermediate/certs/idol-mmap-app.pkcs12:/ssl/certs/idol-mmap-app.pkcs12:ro
      # CA / intermediate cert (for client truststore)
      - /home/kduser/idol-sandbox/idol-containers-toolkit/basic-idol/ssl/intermediate/certs/intermediate.pkcs12:/ssl/certs/intermediate.pkcs12:ro
      - ./ssl/intermediate/certs:/ssl/certs:ro
    networks:
      - DEPLOYMENT-TYPE-PLACEHOLDER 
  
networks:
  DEPLOYMENT-TYPE-PLACEHOLDER:
    external: true    